{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Debrief",
  "version": "0.780.17",
  "identifier": "app.debrief",
  "build": {
    "beforeDevCommand": "pnpm --filter desktop sync-version && pnpm --filter shared build && pnpm --filter @notes/cli build && pnpm --filter web dev",
    "beforeBuildCommand": "pnpm --filter desktop sync-version && pnpm --filter shared build && pnpm --filter @notes/cli build && pnpm --filter web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Debrief",
        "create": false,
        "width": 1440,
        "height": 900,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false,
        "transparent": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": ["**"], "deny": ["$APPDATA/**", "$APPLOCALDATA/**", "$HOME/AppData/**", "$HOME/Library/WebKit/**", "$HOME/Library/Application Support/app.debrief/**", "$HOME/.ssh/**", "$HOME/.gnupg/**", "$HOME/.aws/**", "$HOME/.kube/**", "$HOME/.docker/**", "$HOME/.config/gh/**", "$HOME/.local/share/keyrings/**"] }
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' data: blob: ipc://localhost http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../cli/dist/pn.mjs": "pn.mjs"
    },
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Assets.car"
    ],
    "copyright": "© 2026 Lifetime Labs LLC",
    "publisher": "Lifetime Labs LLC",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Default",
        "contentTypes": ["net.daringfireball.markdown"]
      },
      {
        "ext": ["txt"],
        "name": "Plain text document",
        "description": "Plain text document",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": ["public.plain-text"]
      }
    ],
    "shortDescription": "Private notes with a gaming journal. Local only.",
    "longDescription": "Debrief is a private notes app with a gaming journal. Notes stay in a local library on your device. There is no account and no hosted sync.",
    "iOS": {
      "developmentTeam": "PV88JJL329",
      "minimumSystemVersion": "17.4"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": "./dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 }
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsi"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "desktopTemplate": "./linux/privacynotes.desktop",
        "recommends": ["gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad"],
        "files": {
          "/usr/share/metainfo/app.privacynotes.metainfo.xml": "metainfo/app.privacynotes.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": true
    },
    "deep-link": {
      "desktop": {
        "schemes": ["privacynotes"]
      },
      "mobile": [
        {
          "scheme": ["https"],
          "host": "use.privacynotes.app",
          "pathPrefix": ["/auth/callback", "/note"],
          "appLink": true
        }
      ]
    },
    "updater": {
      "endpoints": [
        "https://releases.privacynotes.app/u/{{target}}-{{arch}}/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDOTc2Njg3OTIxODlFNUYKUldSZm5oaVNoMmFYYkEvMGdRZ1lzOVJRN0lnd0RlbFgwZ1hGTzhHVU5MUUFLMEk3UnpjNWR0L2YK"
    }
  }
}
